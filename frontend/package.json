{
  "name": "vividia-frontend",
  "private": true,
  "type": "module",
  "description": "Screens for Vividia. The lib/ modules here are plain TypeScript with no framework, so they can be tested without a browser; Vite and React sit on top of them.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
