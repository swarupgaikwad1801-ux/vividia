# Copy to frontend/.env.local for local work. Never commit a real .env file.
#
# Where lib/api.ts sends requests. Empty means "same origin", which is what the
# deployed build uses when the frontend and backend sit behind one domain.
#
# Against the local backend run with mocks (no API key, costs nothing):
#   cd backend && python -m uvicorn main:app --reload
VITE_API_URL=http://127.0.0.1:8000

# No secret belongs in this file or any VITE_* variable. Vite inlines every
# VITE_* value into the JavaScript it ships, so anything here is public the
# moment the site is deployed. API keys stay in the backend's own .env.
