# Copy this file to .env in the repo root. Never commit .env.
# Every value comes from the Nebius Token Factory console. Do not guess them.

NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Exact model IDs, from the console or: python -m engine.smoke_test --list-models
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b

TAVILY_API_KEY=

# Public demo limits (optional; the defaults in backend/app/limits.py are used
# when these are unset). The dollar cap is what keeps the demo alive until
# 15 Dec: $25 over 52 days is about $0.48/day, so the default is $0.40.
# The per-client limit is a courtesy only - X-Forwarded-For can be spoofed.
DEMO_DAILY_USD_CAP=0.40
DEMO_PER_IP_REQUESTS=40
DEMO_PER_IP_WINDOW_S=3600
